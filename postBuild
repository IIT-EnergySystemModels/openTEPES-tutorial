#!/bin/bash
# Binder (repo2docker) runs this after the conda environment is built.
# It installs openTEPES straight from the bundled git submodule (external/openTEPES),
# in editable mode, so the tutorial always uses the repository version rather than
# the PyPI release, and users can read or edit the model source.
set -euo pipefail

# Binder's content provider already checks out the submodule, so its files are present.
# Only initialise it if they are missing (e.g. a clone made without --recurse-submodules).
# Doing this unconditionally would fail when the build context has no .git directory.
if [ ! -f external/openTEPES/pyproject.toml ]; then
    git submodule update --init --recursive
fi

# Editable install. Must happen here, not in environment.yml: at environment-build
# time the submodule directory is still empty, because postBuild runs afterwards.
pip install -e ./external/openTEPES

echo "openTEPES installed from submodule:"
python -c "import openTEPES; print('  version', openTEPES.__version__)"
